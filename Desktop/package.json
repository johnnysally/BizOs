{
  "name": "bizos-desktop",
  "version": "1.0.0",
  "description": "BizOS — Business OS desktop application",
  "author": {
    "name": "BizOS",
    "email": "support@bizos.co.ke"
  },
  "homepage": "https://bizos.com",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "vite --port 3000 --strictPort",
    "electron:dev": "electron-vite build && electron .",
    "electron:build": "electron-vite build",
    "electron:preview": "electron-vite build && electron .",
    "assets": "tsx scripts/generate-assets.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "postinstall": "node scripts/fix-electron-path.mjs && electron-builder install-app-deps"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^43.5.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "sharp": "^0.34.2",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}